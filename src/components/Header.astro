---
import Default from '@astrojs/starlight/components/Header.astro';
---

<p class="ribbon">
	<span class="ribbon-text">Open source projects by Jean Carlo Benites Porras.</span>
	<a href="https://aquilabot.dev">aquilabot.dev <span aria-hidden="true">↗</span></a>
</p>
<Default />

<style>
	.ribbon {
		position: absolute;
		inset: 0 0 auto 0;
		height: var(--ribbon);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin: 0;
		padding-inline: var(--sl-nav-pad-x);
		background: var(--code-bg);
		border-bottom: 1px solid var(--line);
		color: var(--faint);
		font-size: 0.75rem;
		line-height: 1;
		white-space: nowrap;
	}
	.ribbon-text {
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.ribbon a {
		color: var(--muted);
		text-decoration: none;
		transition: color 150ms ease-out;
	}
	.ribbon a:hover {
		color: var(--text);
	}
	.ribbon a span {
		color: var(--accent);
	}
	@media (max-width: 40rem) {
		.ribbon-text {
			display: none;
		}
	}
	@media print {
		.ribbon {
			display: none;
		}
	}
</style>
